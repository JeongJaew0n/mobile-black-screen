{
  "$description": "검은 화면(mobile-black-screen)의 디자인 토큰. W3C Design Tokens(DTCG) 형식. 이 파일이 유일한 원본이고 ui/theme/Tokens.kt 는 build.py 가 여기서 만든다. 세 층: ref(원시값) → sys(의도) → comp(부품). sys 는 ref 만, comp 는 sys·ref 만 가리킨다. 다른 제품에 가져가는 것은 ref+sys 다. dimension 의 px 는 논리 픽셀(Android dp / iOS pt / Web px)이며, 경로에 fontSize·letterSpacing 이 있으면 글자 단위(sp)로 낸다.",

  "ref": {
    "palette": {
      "$type": "color",
      "black": { "$value": "#000000" },
      "white": { "$value": "#FFFFFF" },
      "ink900": { "$value": "#141414", "$description": "떠 있는 표면의 바탕색. 순검정보다 한 톤 밝아 검은 앱 위에서도 윤곽이 잡힌다." },
      "ink850": { "$value": "#202020" },
      "blue500": { "$value": "#2F6FA8" },
      "red500": { "$value": "#C0392B" },
      "white20": { "$value": "#FFFFFF33", "$description": "흰색 20%. 어두운 표면의 얇은 테두리." },
      "white70": { "$value": "#FFFFFFB3", "$description": "흰색 70%. 어두운 표면 위의 기호·라벨 — 100% 면 표면에서 뜬다." },
      "ink900a88": { "$value": "#141414E0", "$description": "ink900 88%. 뒤가 살짝 비쳐 '떠 있다' 는 인상. 불투명하면 화면에 붙은 딱지처럼 보인다." },
      "ink850a75": { "$value": "#202020C0", "$description": "ink850 75%. ink900a88 보다 밝고 더 비친다 — 뒤로 물러나 보여야 하는 표면." },
      "blue500a94": { "$value": "#2F6FA8F0" },
      "red500a94": { "$value": "#C0392BF0" }
    },

    "opacity": {
      "$type": "number",
      "o6": { "$value": 0.06 },
      "o12": { "$value": 0.12 },
      "o22": { "$value": 0.22 },
      "o25": { "$value": 0.25 },
      "o30": { "$value": 0.3 },
      "o40": { "$value": 0.4 },
      "o45": { "$value": 0.45 },
      "o55": { "$value": 0.55 },
      "o70": { "$value": 0.7 },
      "o85": { "$value": 0.85 },
      "full": { "$value": 1.0 }
    },

    "dimension": {
      "$type": "dimension",
      "d1": { "$value": { "value": 1, "unit": "px" } },
      "d1_5": { "$value": { "value": 1.5, "unit": "px" } },
      "d2": { "$value": { "value": 2, "unit": "px" } },
      "d3": { "$value": { "value": 3, "unit": "px" } },
      "d4": { "$value": { "value": 4, "unit": "px" } },
      "d5": { "$value": { "value": 5, "unit": "px" } },
      "d6": { "$value": { "value": 6, "unit": "px" } },
      "d8": { "$value": { "value": 8, "unit": "px" } },
      "d10": { "$value": { "value": 10, "unit": "px" } },
      "d12": { "$value": { "value": 12, "unit": "px" } },
      "d14": { "$value": { "value": 14, "unit": "px" } },
      "d16": { "$value": { "value": 16, "unit": "px" } },
      "d18": { "$value": { "value": 18, "unit": "px" } },
      "d20": { "$value": { "value": 20, "unit": "px" } },
      "d24": { "$value": { "value": 24, "unit": "px" } },
      "d28": { "$value": { "value": 28, "unit": "px" } },
      "d30": { "$value": { "value": 30, "unit": "px" } },
      "d32": { "$value": { "value": 32, "unit": "px" } },
      "d40": { "$value": { "value": 40, "unit": "px" } },
      "d44": { "$value": { "value": 44, "unit": "px" } },
      "d46": { "$value": { "value": 46, "unit": "px" } },
      "d52": { "$value": { "value": 52, "unit": "px" } },
      "d56": { "$value": { "value": 56, "unit": "px" } },
      "d64": { "$value": { "value": 64, "unit": "px" } },
      "d72": { "$value": { "value": 72, "unit": "px" } },
      "d84": { "$value": { "value": 84, "unit": "px" } },
      "d112": { "$value": { "value": 112, "unit": "px" } },
      "d180": { "$value": { "value": 180, "unit": "px" } },
      "d300": { "$value": { "value": 300, "unit": "px" } }
    },

    "fontSize": {
      "$type": "dimension",
      "f12": { "$value": { "value": 12, "unit": "px" } },
      "f13": { "$value": { "value": 13, "unit": "px" } },
      "f14": { "$value": { "value": 14, "unit": "px" } },
      "f15": { "$value": { "value": 15, "unit": "px" } },
      "f16": { "$value": { "value": 16, "unit": "px" } },
      "f17": { "$value": { "value": 17, "unit": "px" } },
      "f18": { "$value": { "value": 18, "unit": "px" } },
      "f22": { "$value": { "value": 22, "unit": "px" } },
      "f64": { "$value": { "value": 64, "unit": "px" } }
    },

    "letterSpacing": {
      "$type": "dimension",
      "wide": { "$value": { "value": 1, "unit": "px" } }
    },

    "duration": {
      "$type": "duration",
      "ms150": { "$value": { "value": 150, "unit": "ms" } },
      "ms160": { "$value": { "value": 160, "unit": "ms" } },
      "ms400": { "$value": { "value": 400, "unit": "ms" } },
      "ms3000": { "$value": { "value": 3000, "unit": "ms" } }
    }
  },

  "sys": {
    "$description": "의도 층. 다른 제품에 가져가는 것은 이 층과 ref 다. 이름은 '어디에 쓰는가' 가 아니라 '무엇을 뜻하는가' 로 짓는다.",

    "color": {
      "$type": "color",
      "canvas": { "$value": "{ref.palette.black}", "$description": "차폐 화면의 바탕. 이 앱의 기본 상태는 이 색 하나만 보이는 것이다." },
      "onCanvas": { "$value": "{ref.palette.white}", "$description": "캔버스 위의 글자·기호. 항상 흰색이다 — 보이는 밝기는 프레임버퍼 값 × 패널 밝기라, 글자를 회색으로 낮추면 패널 밝기 0.30 에서 읽히지 않는다. 실제로 세 번 그랬다." },
      "floatingSurface": { "$value": "{ref.palette.ink900a88}", "$description": "다른 앱 위에 떠 있는 UI 의 표면 — 버블, 설정의 버블 견본." },
      "floatingSurfaceMuted": { "$value": "{ref.palette.ink850a75}", "$description": "떠 있는 UI 중 뒤로 물러나 보여야 하는 것 — 겨냥 칩의 비활성 상태." },
      "floatingBorder": { "$value": "{ref.palette.white20}", "$description": "떠 있는 표면의 얇은 테두리. 항상 stroke.hairline 굵기로 쓴다." },
      "floatingContent": { "$value": "{ref.palette.white70}", "$description": "떠 있는 표면 위의 기호·라벨." },
      "accentPositive": { "$value": "{ref.palette.blue500a94}", "$description": "'열기·진행' 계열 강조. 겨냥 위(앱 열기)." },
      "accentDestructive": { "$value": "{ref.palette.red500a94}", "$description": "'지우기·닫기' 계열 강조. 겨냥 아래(버블 닫기)." }
    },

    "opacity": {
      "$type": "number",
      "$description": "글자색(tint)에 곱하는 상대 불투명도. 이 앱의 글자색은 설정이 정하므로 색을 고정할 수 없고 '몇 %' 로만 단계를 둘 수 있다.",
      "full": { "$value": "{ref.opacity.full}" },
      "strong": { "$value": "{ref.opacity.o85}", "$description": "거의 불투명한 채움 — 손잡이처럼 잡을 것." },
      "secondary": { "$value": "{ref.opacity.o70}", "$description": "보조 텍스트. 제목보다 한 단계 낮춘다." },
      "hint": { "$value": "{ref.opacity.o55}", "$description": "안내 문구 · 표시 위의 작은 표식. 있어야 하지만 주인공은 아니다." },
      "medium": { "$value": "{ref.opacity.o45}", "$description": "또렷해야 하는 테두리." },
      "idle": { "$value": "{ref.opacity.o40}", "$description": "한동안 손대지 않은 떠 있는 UI." },
      "disabled": { "$value": "{ref.opacity.o30}", "$description": "누를 수 없는 버튼." },
      "weak": { "$value": "{ref.opacity.o25}", "$description": "채워지기 전의 바탕 막대." },
      "hairline": { "$value": "{ref.opacity.o22}", "$description": "윤곽만 잡는 테두리." },
      "scrim": { "$value": "{ref.opacity.o12}", "$description": "아래를 거의 다 보여 줘야 하는 덮개. 0.55 로는 PIN 입력 화면의 숫자가 안 보였다 — 탈출구는 실제로 쓸 수 있어야 의미가 있다." },
      "faint": { "$value": "{ref.opacity.o6}", "$description": "있는지 겨우 느껴지는 채움. 알약 버튼의 바탕." }
    },

    "typography": {
      "$type": "dimension",
      "display": { "$value": "{ref.fontSize.f64}", "$description": "시계." },
      "headline": { "$value": "{ref.fontSize.f22}", "$description": "날짜 · 배터리 잔량. 시계 아래 줄." },
      "body": { "$value": "{ref.fontSize.f18}", "$description": "문장 · 글꼴 견본." },
      "title": { "$value": "{ref.fontSize.f17}", "$description": "버튼 라벨." },
      "labelLarge": { "$value": "{ref.fontSize.f16}", "$description": "재생 제목 · 칩 기호." },
      "label": { "$value": "{ref.fontSize.f15}", "$description": "칩 라벨 · 트랙 안내." },
      "captionLarge": { "$value": "{ref.fontSize.f14}", "$description": "권한 안내." },
      "caption": { "$value": "{ref.fontSize.f13}", "$description": "재생 부제." },
      "captionSmall": { "$value": "{ref.fontSize.f12}", "$description": "재생 시간." },
      "letterSpacingWide": { "$value": "{ref.letterSpacing.wide}", "$description": "짧은 버튼 라벨을 조금 벌려 또렷하게." }
    },

    "spacing": {
      "$type": "dimension",
      "xxs": { "$value": "{ref.dimension.d2}" },
      "xs": { "$value": "{ref.dimension.d4}" },
      "sm": { "$value": "{ref.dimension.d8}" },
      "md": { "$value": "{ref.dimension.d12}" },
      "lg": { "$value": "{ref.dimension.d16}" },
      "xl": { "$value": "{ref.dimension.d20}" },
      "xxl": { "$value": "{ref.dimension.d24}" },
      "xxxl": { "$value": "{ref.dimension.d32}" }
    },

    "radius": {
      "small": { "$type": "dimension", "$value": "{ref.dimension.d8}", "$description": "누르는 행." },
      "card": { "$type": "dimension", "$value": "{ref.dimension.d12}", "$description": "미리보기 상자 · 글꼴 견본 칩." },
      "pill": { "$type": "number", "$value": 50, "$description": "알약. 반지름을 %로 — 높이의 절반." }
    },

    "stroke": {
      "$type": "dimension",
      "hairline": { "$value": "{ref.dimension.d1}", "$description": "윤곽만 잡는 테두리." },
      "emphasis": { "$value": "{ref.dimension.d2}", "$description": "선택된 것의 테두리." }
    },

    "motion": {
      "$type": "duration",
      "fast": { "$value": "{ref.duration.ms150}", "$description": "손가락에 바로 반응하는 것 — 커짐·색 바뀜." },
      "fade": { "$value": "{ref.duration.ms400}", "$description": "천천히 흐려지고 돌아오는 것." },
      "idleDelay": { "$value": "{ref.duration.ms3000}", "$description": "이만큼 손대지 않으면 유휴로 본다." }
    },

    "touchTarget": {
      "$type": "dimension",
      "min": { "$value": "{ref.dimension.d44}", "$description": "접근성 권장 최소 터치 영역." }
    }
  },

  "comp": {
    "$description": "부품 층. 이 앱의 것이다. 색·치수·시간은 sys 또는 ref 를 가리킨다 — 리터럴은 비율(number)만 허용한다. 비율에는 팔레트가 없다.",

    "content": {
      "$description": "차폐 화면 한가운데의 시계·날짜·배터리·문장 블록.",
      "verticalBias": { "$type": "number", "$value": -0.3, "$description": "정중앙에서 위로 화면 높이의 15%. 손에 들었을 때 시선이 닿는 높이." },
      "clockSize": { "$type": "dimension", "$value": "{sys.typography.display}" },
      "dateSize": { "$type": "dimension", "$value": "{sys.typography.headline}" },
      "sentenceSize": { "$type": "dimension", "$value": "{sys.typography.body}" },
      "sentenceInset": { "$type": "dimension", "$value": "{ref.dimension.d40}", "$description": "문장 좌우 여백. 긴 문장이 화면 끝까지 닿지 않게." },
      "gapSmall": { "$type": "dimension", "$value": "{sys.spacing.sm}", "$description": "시계 → 날짜 → 배터리 사이." },
      "gapLarge": { "$type": "dimension", "$value": "{sys.spacing.xxl}", "$description": "블록 → 문장 사이. 문장은 한 덩어리가 아니라 따로 읽힌다." }
    },

    "dimmedScrim": {
      "opacity": { "$type": "number", "$value": "{sys.opacity.scrim}", "$description": "지문 프롬프트·PIN 입력이 떠 있는 동안 차폐의 알파." }
    },

    "unlockRing": {
      "$description": "꾹 눌러 해제의 진행 링.",
      "size": { "$type": "dimension", "$value": "{ref.dimension.d64}" },
      "stroke": { "$type": "dimension", "$value": "{ref.dimension.d3}" },
      "verticalOffsetFraction": { "$type": "number", "$value": 0.28, "$description": "화면 높이 대비 중앙에서 아래로. 정중앙은 시계·문장이 쓴다." },
      "fadeInBoost": { "$type": "number", "$value": 1.4, "$description": "진행률에 곱해 알파를 앞당긴다. 초반에도 링이 보이게." }
    },

    "slideDismiss": {
      "duration": { "$type": "duration", "$value": "{ref.duration.ms160}", "$description": "손을 뗀 뒤 남은 거리를 마저 밀어내는 시간." }
    },

    "slideTrack": {
      "$description": "밀어서 잠금 해제 트랙. 지금은 미제공(Gesture.available=false)이지만 코드가 남아 있다.",
      "height": { "$type": "dimension", "$value": "{ref.dimension.d56}" },
      "knob": { "$type": "dimension", "$value": "{ref.dimension.d46}" },
      "inset": { "$type": "dimension", "$value": "{ref.dimension.d5}" },
      "bottomMargin": { "$type": "dimension", "$value": "{ref.dimension.d72}" },
      "widthFraction": { "$type": "number", "$value": 0.66, "$description": "넓으면 화면을 가로지르는 막대처럼 보여 답답하다." },
      "borderOpacity": { "$type": "number", "$value": "{sys.opacity.hairline}" },
      "hintSize": { "$type": "dimension", "$value": "{sys.typography.label}" },
      "hintOpacity": { "$type": "number", "$value": "{sys.opacity.hint}" },
      "hintFade": { "$type": "number", "$value": 1.6, "$description": "손잡이 진행률에 곱해 안내 문구를 빨리 물린다." },
      "knobOpacity": { "$type": "number", "$value": "{sys.opacity.strong}" },
      "knobMarkWidth": { "$type": "dimension", "$value": "{ref.dimension.d14}", "$description": "손잡이 안의 가로 막대 — 앱의 막대 모티프." },
      "knobMarkHeight": { "$type": "dimension", "$value": "{ref.dimension.d2}" },
      "knobMarkOpacity": { "$type": "number", "$value": "{sys.opacity.hint}" }
    },

    "fingerprintButton": {
      "$description": "지문 해제의 '잠금 해제' 알약 버튼. 재생 컨트롤이 있을 때만 보인다.",
      "verticalBias": { "$type": "number", "$value": 0.25, "$description": "위에서 62.5%. 시계 블록(~45%)과 재생 컨트롤(~78%)의 중간." },
      "borderOpacity": { "$type": "number", "$value": "{sys.opacity.medium}" },
      "fillOpacity": { "$type": "number", "$value": "{sys.opacity.faint}" },
      "paddingHorizontal": { "$type": "dimension", "$value": "{ref.dimension.d30}" },
      "paddingVertical": { "$type": "dimension", "$value": "{ref.dimension.d14}" },
      "fontSize": { "$type": "dimension", "$value": "{sys.typography.title}" },
      "letterSpacing": { "$type": "dimension", "$value": "{sys.typography.letterSpacingWide}" }
    },

    "mediaBar": {
      "$description": "하단 재생 바 — 제목 · 부제 · 진행 막대 · 시간.",
      "bottomMargin": { "$type": "dimension", "$value": "{ref.dimension.d72}", "$description": "예전 밀어서 잠금 해제 트랙이 있던 자리." },
      "widthFraction": { "$type": "number", "$value": 0.8 },
      "titleSize": { "$type": "dimension", "$value": "{sys.typography.labelLarge}" },
      "subtitleSize": { "$type": "dimension", "$value": "{sys.typography.caption}" },
      "subtitleOpacity": { "$type": "number", "$value": "{sys.opacity.secondary}" },
      "subtitleGap": { "$type": "dimension", "$value": "{sys.spacing.xxs}" },
      "barGap": { "$type": "dimension", "$value": "{ref.dimension.d10}", "$description": "부제 → 진행 막대." },
      "barHeight": { "$type": "dimension", "$value": "{ref.dimension.d2}", "$description": "손잡이 없는 얇은 막대. 제어가 없으니 잡을 것도 없다." },
      "trackOpacity": { "$type": "number", "$value": "{sys.opacity.weak}" },
      "timeGap": { "$type": "dimension", "$value": "{sys.spacing.md}" },
      "timeSize": { "$type": "dimension", "$value": "{sys.typography.captionSmall}" },
      "timeOpacity": { "$type": "number", "$value": "{sys.opacity.secondary}" },
      "permissionHintSize": { "$type": "dimension", "$value": "{sys.typography.captionLarge}" },
      "permissionHintOpacity": { "$type": "number", "$value": "{sys.opacity.hint}" }
    },

    "mediaControls": {
      "$description": "이전 · 재생/일시정지 · 다음.",
      "lift": { "$type": "dimension", "$value": "{ref.dimension.d84}", "$description": "재생 바 위로 얹는 높이 — 바의 높이만큼." },
      "gap": { "$type": "dimension", "$value": "{ref.dimension.d28}" },
      "buttonSize": { "$type": "dimension", "$value": "{sys.touchTarget.min}" },
      "disabledOpacity": { "$type": "number", "$value": "{sys.opacity.disabled}" }
    },

    "battery": {
      "$description": "배터리 그림 + 퍼센트 한 줄.",
      "glyphWidth": { "$type": "dimension", "$value": "{ref.dimension.d30}" },
      "glyphHeight": { "$type": "dimension", "$value": "{ref.dimension.d14}" },
      "glyphStroke": { "$type": "dimension", "$value": "{ref.dimension.d1_5}" },
      "gap": { "$type": "dimension", "$value": "{sys.spacing.sm}" },
      "fontSize": { "$type": "dimension", "$value": "{sys.typography.headline}" }
    },

    "bubble": {
      "$description": "상주 버블. 크기는 사용자 설정이라 여기 없다.",
      "surface": { "$type": "color", "$value": "{sys.color.floatingSurface}" },
      "border": { "$type": "color", "$value": "{sys.color.floatingBorder}" },
      "borderWidth": { "$type": "dimension", "$value": "{sys.stroke.hairline}" },
      "content": { "$type": "color", "$value": "{sys.color.floatingContent}" },
      "glyphFraction": { "$type": "number", "$value": 0.5, "$description": "기호는 버블 지름의 절반 안에. 가장자리까지 차면 테두리와 붙어 답답하다." },
      "glyphStroke": { "$type": "dimension", "$value": "{ref.dimension.d2}", "$description": "버블 크기에 비례시키지 않는다 — 16dp 에서도 2dp 는 보이고, 96dp 에서 8dp 는 둔하다." },
      "idleOpacity": { "$type": "number", "$value": "{sys.opacity.idle}" },
      "idleDelay": { "$type": "duration", "$value": "{sys.motion.idleDelay}" },
      "fadeDuration": { "$type": "duration", "$value": "{sys.motion.fade}" }
    },

    "aimChip": {
      "$description": "버블을 꾹 누른 뒤 위/아래에 뜨는 두 목표.",
      "surfaceIdle": { "$type": "color", "$value": "{sys.color.floatingSurfaceMuted}" },
      "surfaceUp": { "$type": "color", "$value": "{sys.color.accentPositive}" },
      "surfaceDown": { "$type": "color", "$value": "{sys.color.accentDestructive}" },
      "contentActive": { "$type": "color", "$value": "{sys.color.onCanvas}" },
