{
  "$description": "검은 화면(mobile-black-screen)의 디자인 토큰. 팔레트는 수묵화(Figma Ink wash, 2026-09-28). W3C Design Tokens(DTCG) 형식. 이 파일이 유일한 원본이고 ui/theme/Tokens.kt 는 build.py 가 여기서 만든다. 세 층: ref(원시값) → sys(의도) → comp(부품). sys 는 ref 만, comp 는 sys·ref 만 가리킨다. 다른 제품에 가져가는 것은 ref+sys 다. dimension 의 px 는 논리 픽셀(Android dp / iOS pt / Web px)이며, 경로에 fontSize·letterSpacing 이 있으면 글자 단위(sp)로 낸다.",

  "ref": {
    "palette": {
      "$type": "color",
      "$description": "수묵화(Figma 'Ink wash' — #4A4A4A · #CBCBCB · #FFFFE3 · #6D8196)를 이 앱에 맞게 펼친 팔레트. 피그마 원색 넷은 설명에 '원색' 으로 표시했고, 나머지는 그 사이·양 끝을 메운 톤이다.",
      "black": { "$value": "#000000", "$description": "차폐 바탕. AMOLED 에서 발광하지 않는다 — 이 앱의 존재 이유라 팔레트가 바뀌어도 그대로다." },
      "paper": { "$value": "#FFFFE3", "$description": "원색. 한지색. 흰색 대비 98.6% 밝기라 패널 0.30 에서도 흰 글자와 같이 읽히면서 푸른 기가 빠진다." },
      "wash200": { "$value": "#DEDEDA" },
      "wash300": { "$value": "#CBCBCB", "$description": "원색. 옅은 먹. 어두운 표면 위의 기호·보조 텍스트." },
      "wash400": { "$value": "#9E9E9E" },
      "wash500": { "$value": "#7C7C7C" },
      "wash600": { "$value": "#616161" },
      "wash700": { "$value": "#4A4A4A", "$description": "원색. 먹색. 떠 있는 표면." },
      "wash750": { "$value": "#363636" },
      "wash800": { "$value": "#2A2A2A" },
      "wash850": { "$value": "#1F1F1F" },
      "wash900": { "$value": "#161616", "$description": "설정 화면의 바탕. 순검정보다 한 톤 위라 카드·시트가 떠 보인다." },
      "wash950": { "$value": "#0E0E0E" },
      "slate200": { "$value": "#C9D3DE" },
      "slate300": { "$value": "#A7B6C6", "$description": "어두운 바탕 위 강조(Material primary). 먹색 계열 위에서 8.7:1." },
      "slate500": { "$value": "#6D8196", "$description": "원색. 청회색. 스케일의 기준 톤. 흰 글자를 얹으면 4.0:1 로 모자라 강조 표면으로는 slate700 을 쓴다." },
      "slate700": { "$value": "#4C5D70" },
      "slate800": { "$value": "#2C3845" },
      "slate900": { "$value": "#1E2630" },
      "red200": { "$value": "#F2B8B0" },
      "red500": { "$value": "#C0392B", "$description": "지우기·닫기. 수묵화에 경고색이 없어 이전 팔레트의 값을 그대로 둔다 — '열기' 와 헷갈리면 안 된다." },
      "red800": { "$value": "#7A2419" },
      "red900": { "$value": "#5C1A12" },
      "paper20": { "$value": "#FFFFE333", "$description": "paper 20%. 어두운 표면의 얇은 테두리." },
      "wash700a88": { "$value": "#4A4A4AE0", "$description": "먹색 88%. 뒤가 살짝 비쳐 '떠 있다' 는 인상." },
      "wash800a94": { "$value": "#2A2A2AF0", "$description": "짙은 먹 94%. 뒤로 물러나되 뒤 글자가 비치지 않는 표면. 75% 로는 설정 화면 위에서 라벨이 뒤 글자와 섞였다(실기기, 2026-09-28)." },
      "slate700a94": { "$value": "#4C5D70F0" },
      "red500a94": { "$value": "#C0392BF0" }
    },

    "opacity": {
      "$type": "number",
      "o6": { "$value": 0.06 },
      "o12": { "$value": 0.12 },
      "o22": { "$value": 0.22 },
      "o25": { "$value": 0.25 },
      "o30": { "$value": 0.3 },
      "o40": { "$value": 0.4 },
      "o45": { "$value": 0.45 },
      "o55": { "$value": 0.55 },
      "o70": { "$value": 0.7 },
      "o85": { "$value": 0.85 },
      "full": { "$value": 1.0 }
    },

    "dimension": {
      "$type": "dimension",
      "d1": { "$value": { "value": 1, "unit": "px" } },
      "d1_5": { "$value": { "value": 1.5, "unit": "px" } },
      "d2": { "$value": { "value": 2, "unit": "px" } },
      "d3": { "$value": { "value": 3, "unit": "px" } },
      "d4": { "$value": { "value": 4, "unit": "px" } },
      "d5": { "$value": { "value": 5, "unit": "px" } },
      "d6": { "$value": { "value": 6, "unit": "px" } },
      "d8": { "$value": { "value": 8, "unit": "px" } },
      "d10": { "$value": { "value": 10, "unit": "px" } },
      "d12": { "$value": { "value": 12, "unit": "px" } },
      "d14": { "$value": { "value": 14, "unit": "px" } },
      "d16": { "$value": { "value": 16, "unit": "px" } },
      "d18": { "$value": { "value": 18, "unit": "px" } },
      "d20": { "$value": { "value": 20, "unit": "px" } },
      "d24": { "$value": { "value": 24, "unit": "px" } },
      "d28": { "$value": { "value": 28, "unit": "px" } },
      "d30": { "$value": { "value": 30, "unit": "px" } },
      "d32": { "$value": { "value": 32, "unit": "px" } },
      "d40": { "$value": { "value": 40, "unit": "px" } },
      "d44": { "$value": { "value": 44, "unit": "px" } },
      "d46": { "$value": { "value": 46, "unit": "px" } },
      "d48": { "$value": { "value": 48, "unit": "px" } },
      "d52": { "$value": { "value": 52, "unit": "px" } },
      "d56": { "$value": { "value": 56, "unit": "px" } },
      "d64": { "$value": { "value": 64, "unit": "px" } },
      "d72": { "$value": { "value": 72, "unit": "px" } },
      "d84": { "$value": { "value": 84, "unit": "px" } },
      "d112": { "$value": { "value": 112, "unit": "px" } },
      "d180": { "$value": { "value": 180, "unit": "px" } },
      "d300": { "$value": { "value": 300, "unit": "px" } }
    },

    "fontSize": {
      "$type": "dimension",
      "f12": { "$value": { "value": 12, "unit": "px" } },
      "f13": { "$value": { "value": 13, "unit": "px" } },
      "f14": { "$value": { "value": 14, "unit": "px" } },
      "f15": { "$value": { "value": 15, "unit": "px" } },
      "f16": { "$value": { "value": 16, "unit": "px" } },
      "f17": { "$value": { "value": 17, "unit": "px" } },
      "f18": { "$value": { "value": 18, "unit": "px" } },
      "f22": { "$value": { "value": 22, "unit": "px" } },
      "f64": { "$value": { "value": 64, "unit": "px" } }
    },

    "letterSpacing": {
      "$type": "dimension",
      "wide": { "$value": { "value": 1, "unit": "px" } }
    },

    "duration": {
      "$type": "duration",
      "ms150": { "$value": { "value": 150, "unit": "ms" } },
      "ms160": { "$value": { "value": 160, "unit": "ms" } },
      "ms400": { "$value": { "value": 400, "unit": "ms" } },
      "ms3000": { "$value": { "value": 3000, "unit": "ms" } },
      "ms5000": { "$value": { "value": 5000, "unit": "ms" } }
    }
  },

  "sys": {
    "$description": "의도 층. 다른 제품에 가져가는 것은 이 층과 ref 다. 이름은 '어디에 쓰는가' 가 아니라 '무엇을 뜻하는가' 로 짓는다.",

    "color": {
      "$type": "color",
      "canvas": { "$value": "{ref.palette.black}", "$description": "차폐 화면의 바탕. 이 앱의 기본 상태는 이 색 하나만 보이는 것이다." },
      "onCanvas": { "$value": "{ref.palette.paper}", "$description": "캔버스 위의 글자·기호. 거의 흰색이어야 한다 — 보이는 밝기는 프레임버퍼 값 × 패널 밝기라, 회색으로 낮추면 패널 0.30 에서 읽히지 않는다. 실제로 세 번 그랬다. 흑백 대비 19:1 미만은 여기 쓰지 말 것." },
      "floatingSurface": { "$value": "{ref.palette.wash700a88}", "$description": "다른 앱 위에 떠 있는 UI 의 표면 — 버블, 설정의 버블 견본." },
      "floatingSurfaceMuted": { "$value": "{ref.palette.wash800a94}", "$description": "떠 있는 UI 중 뒤로 물러나 보여야 하는 것 — 겨냥 칩의 비활성 상태. 물러남은 투명도가 아니라 어둠으로 낸다 — 투명하면 뒤 글자가 라벨과 섞인다. 라벨(wash300) 대비 8.8:1." },
      "floatingBorder": { "$value": "{ref.palette.paper20}", "$description": "떠 있는 표면의 얇은 테두리. 항상 stroke.hairline 굵기로 쓴다." },
      "floatingContent": { "$value": "{ref.palette.wash300}", "$description": "떠 있는 표면 위의 기호·라벨. 먹색 위 5.5:1." },
      "accentPositive": { "$value": "{ref.palette.slate700a94}", "$description": "'열기·진행' 계열 강조. 겨냥 위(앱 열기). paper 글자 대비 6.7:1." },
      "accentDestructive": { "$value": "{ref.palette.red500a94}", "$description": "'지우기·닫기' 계열 강조. 겨냥 아래(버블 닫기)." },

      "background": { "$value": "{ref.palette.wash900}", "$description": "여기부터는 앱 화면(설정)의 역할. 이름은 Material 3 색 역할과 같다 — colorScheme 에 그대로 꽂힌다." },
      "onBackground": { "$value": "{ref.palette.paper}" },
      "surface": { "$value": "{ref.palette.wash900}" },
      "onSurface": { "$value": "{ref.palette.paper}", "$description": "surface 위 17.8:1." },
      "surfaceVariant": { "$value": "{ref.palette.wash800}" },
      "onSurfaceVariant": { "$value": "{ref.palette.wash300}", "$description": "설명 문구·보조 텍스트. surface 위 11.2:1." },
      "surfaceContainerLowest": { "$value": "{ref.palette.wash950}" },
      "surfaceContainerLow": { "$value": "{ref.palette.wash900}" },
      "surfaceContainer": { "$value": "{ref.palette.wash850}" },
      "surfaceContainerHigh": { "$value": "{ref.palette.wash800}" },
      "surfaceContainerHighest": { "$value": "{ref.palette.wash750}" },
      "primary": { "$value": "{ref.palette.slate300}", "$description": "버튼·선택 표시·스위치. surface 위 8.7:1." },
      "onPrimary": { "$value": "{ref.palette.slate900}" },
      "primaryContainer": { "$value": "{ref.palette.slate800}" },
      "onPrimaryContainer": { "$value": "{ref.palette.slate200}" },
      "secondary": { "$value": "{ref.palette.wash300}" },
      "onSecondary": { "$value": "{ref.palette.wash800}" },
      "secondaryContainer": { "$value": "{ref.palette.wash750}", "$description": "선택된 탭·칩의 바탕." },
      "onSecondaryContainer": { "$value": "{ref.palette.wash200}" },
      "outline": { "$value": "{ref.palette.wash500}", "$description": "입력칸·라디오 테두리. surface 위 4.3:1 — 비텍스트 기준 3:1 을 넘는다." },
      "outlineVariant": { "$value": "{ref.palette.wash750}", "$description": "구분선." },
      "error": { "$value": "{ref.palette.red200}" },
      "onError": { "$value": "{ref.palette.red900}" },
      "errorContainer": { "$value": "{ref.palette.red800}", "$description": "권한 안내 카드의 바탕." },
      "onErrorContainer": { "$value": "{ref.palette.red200}" },
      "inverseSurface": { "$value": "{ref.palette.wash200}", "$description": "스낵바." },
      "inverseOnSurface": { "$value": "{ref.palette.wash850}" },
      "inversePrimary": { "$value": "{ref.palette.slate700}" },
      "scrim": { "$value": "{ref.palette.black}" }
    },

    "opacity": {
      "$type": "number",
      "$description": "글자색(tint)에 곱하는 상대 불투명도. 이 앱의 글자색은 설정이 정하므로 색을 고정할 수 없고 '몇 %' 로만 단계를 둘 수 있다.",
      "full": { "$value": "{ref.opacity.full}" },
      "strong": { "$value": "{ref.opacity.o85}", "$description": "거의 불투명한 채움 — 손잡이처럼 잡을 것." },
      "secondary": { "$value": "{ref.opacity.o70}", "$description": "보조 텍스트. 제목보다 한 단계 낮춘다." },
      "hint": { "$value": "{ref.opacity.o55}", "$description": "안내 문구 · 표시 위의 작은 표식. 있어야 하지만 주인공은 아니다." },
      "medium": { "$value": "{ref.opacity.o45}", "$description": "또렷해야 하는 테두리." },
      "idle": { "$value": "{ref.opacity.o40}", "$description": "한동안 손대지 않은 떠 있는 UI." },
      "disabled": { "$value": "{ref.opacity.o30}", "$description": "누를 수 없는 버튼." },
      "weak": { "$value": "{ref.opacity.o25}", "$description": "채워지기 전의 바탕 막대." },
      "hairline": { "$value": "{ref.opacity.o22}", "$description": "윤곽만 잡는 테두리." },
      "scrim": { "$value": "{ref.opacity.o12}", "$description": "아래를 거의 다 보여 줘야 하는 덮개. 0.55 로는 PIN 입력 화면의 숫자가 안 보였다 — 탈출구는 실제로 쓸 수 있어야 의미가 있다." },
      "faint": { "$value": "{ref.opacity.o6}", "$description": "있는지 겨우 느껴지는 채움. 알약 버튼의 바탕." }
    },

    "typography": {
      "$type": "dimension",
      "display": { "$value": "{ref.fontSize.f64}", "$description": "시계." },
      "headline": { "$value": "{ref.fontSize.f22}", "$description": "날짜 · 배터리 잔량. 시계 아래 줄." },
      "body": { "$value": "{ref.fontSize.f18}", "$description": "문장 · 글꼴 견본." },
      "title": { "$value": "{ref.fontSize.f17}", "$description": "버튼 라벨." },
      "labelLarge": { "$value": "{ref.fontSize.f16}", "$description": "재생 제목 · 칩 기호." },
      "label": { "$value": "{ref.fontSize.f15}", "$description": "칩 라벨 · 트랙 안내." },
      "captionLarge": { "$value": "{ref.fontSize.f14}", "$description": "권한 안내." },
      "caption": { "$value": "{ref.fontSize.f13}", "$description": "재생 부제." },
      "captionSmall": { "$value": "{ref.fontSize.f12}", "$description": "재생 시간." },
      "letterSpacingWide": { "$value": "{ref.letterSpacing.wide}", "$description": "짧은 버튼 라벨을 조금 벌려 또렷하게." }
    },

    "spacing": {
      "$type": "dimension",
      "xxs": { "$value": "{ref.dimension.d2}" },
      "xs": { "$value": "{ref.dimension.d4}" },
      "sm": { "$value": "{ref.dimension.d8}" },
      "md": { "$value": "{ref.dimension.d12}" },
      "lg": { "$value": "{ref.dimension.d16}" },
      "xl": { "$value": "{ref.dimension.d20}" },
      "xxl": { "$value": "{ref.dimension.d24}" },
      "xxxl": { "$value": "{ref.dimension.d32}" }
    },

    "radius": {
      "small": { "$type": "dimension", "$value": "{ref.dimension.d8}", "$description": "누르는 행." },
      "card": { "$type": "dimension", "$value": "{ref.dimension.d12}", "$description": "미리보기 상자 · 글꼴 견본 칩." },
      "pill": { "$type": "number", "$value": 50, "$description": "알약. 반지름을 %로 — 높이의 절반." }
    },

    "stroke": {
      "$type": "dimension",
      "hairline": { "$value": "{ref.dimension.d1}", "$description": "윤곽만 잡는 테두리." },
      "emphasis": { "$value": "{ref.dimension.d2}", "$description": "선택된 것의 테두리." }
    },

    "motion": {
      "$type": "duration",
      "fast": { "$value": "{ref.duration.ms150}", "$description": "손가락에 바로 반응하는 것 — 커짐·색 바뀜." },
      "fade": { "$value": "{ref.duration.ms400}", "$description": "천천히 흐려지고 돌아오는 것." },
      "idleDelay": { "$value": "{ref.duration.ms3000}", "$description": "이만큼 손대지 않으면 유휴로 본다." }
    },

    "touchTarget": {
      "$type": "dimension",
      "min": { "$value": "{ref.dimension.d48}", "$description": "Android 권장 최소 터치 영역 48dp(약 9mm). 예전 44 는 iOS 값(44pt)이었다 — docs/ui-research.md §2." }
    }
  },

  "comp": {
    "$description": "부품 층. 이 앱의 것이다. 색·치수·시간은 sys 또는 ref 를 가리킨다 — 리터럴은 비율(number)만 허용한다. 비율에는 팔레트가 없다.",

    "content": {
      "$description": "차폐 화면 한가운데의 시계·날짜·배터리·문장 블록.",
      "verticalBias": { "$type": "number", "$value": -0.3, "$description": "정중앙에서 위로 화면 높이의 15%. 손에 들었을 때 시선이 닿는 높이." },
      "clockSize": { "$type": "dimension", "$value": "{sys.typography.display}" },
      "dateSize": { "$type": "dimension", "$value": "{sys.typography.headline}" },
      "sentenceSize": { "$type": "dimension", "$value": "{sys.typography.body}" },
      "sentenceInset": { "$type": "dimension", "$value": "{ref.dimension.d40}", "$description": "문장 좌우 여백. 긴 문장이 화면 끝까지 닿지 않게." },
      "gapSmall": { "$type": "dimension", "$value": "{sys.spacing.sm}", "$description": "시계 → 날짜 → 배터리 사이." },
      "gapLarge": { "$type": "dimension", "$value": "{sys.spacing.xxl}", "$description": "블록 → 문장 사이. 문장은 한 덩어리가 아니라 따로 읽힌다." }
    },

    "dimmedScrim": {
      "opacity": { "$type": "number", "$value": "{sys.opacity.scrim}", "$description": "지문 프롬프트·PIN 입력이 떠 있는 동안 차폐의 알파." }
    },

    "unlockRing": {
      "$description": "꾹 눌러 해제의 진행 링.",
      "size": { "$type": "dimension", "$value": "{ref.dimension.d64}" },
      "stroke": { "$type": "dimension", "$value": "{ref.dimension.d3}" },
      "verticalOffsetFraction": { "$type": "number", "$value": 0.28, "$description": "화면 높이 대비 중앙에서 아래로. 정중앙은 시계·문장이 쓴다." },
      "fadeInBoost": { "$type": "number", "$value": 1.4, "$description": "진행률에 곱해 알파를 앞당긴다. 초반에도 링이 보이게." }
    },

    "unlockHint": {
      "$description": "차폐 중 해제 제스처의 첫 동작에 잠깐 뜨는 안내('2번 더 탭하면 풀립니다'). 떠 있는 동안만 밝기를 올린다.",
      "verticalBias": { "$type": "number", "$value": 0.25, "$description": "지문 '잠금 해제' 버튼과 같은 자리 — 시계 블록과 재생 컨트롤 사이. 진행 링 자리(중앙 아래 28%)는 재생 컨트롤과 겹친다." },
      "fontSize": { "$type": "dimension", "$value": "{sys.typography.title}" },
      "inset": { "$type": "dimension", "$value": "{ref.dimension.d40}" },
      "duration": { "$type": "duration", "$value": "{ref.duration.ms5000}", "$description": "AOD '탭하면 10초 표시' 보다 짧게 — 읽을 문장이 한 줄뿐이다." }
    },

