<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      설정 화면. 창 배경을 Compose 의 surface 와 같은 색으로 둬 첫 프레임 전에 다른 색이 비치지 않게 한다.
      색은 전부 tokens_colors.xml(생성물) 에서 온다.
    -->
    <style name="Theme.BlackScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sys_color_background</item>
        <item name="android:colorAccent">@color/sys_color_primary</item>
    </style>

    <!--
      차폐 화면 전용 테마.
      windowBackground 을 검정으로 고정해 Activity 전환 순간의 흰 깜빡임을 없앤다.
    -->
    <style name="Theme.Blackout" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sys_color_canvas</item>
        <item name="android:statusBarColor">@color/sys_color_canvas</item>
        <item name="android:navigationBarColor">@color/sys_color_canvas</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- 오버레이 서비스를 띄우고 즉시 사라지는 중계 Activity 용. -->
    <style name="Theme.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
