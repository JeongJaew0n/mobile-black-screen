<?xml version="1.0" encoding="utf-8"?>
<!--
  English — the default. Any locale without its own values-xx/ falls back here.
  Korean lives in values-ko/. To add a language, add one values-xx/strings.xml.

  ⚠️ Strings that quote OS settings labels: overlay_permission_needed, bubble_permission_note,
  accessibility_needed, accessibility_open. Use the platform's own wording for each language,
  not a literal translation, or users cannot find the setting.
-->
<resources>
    <string name="app_name">Black Screen</string>
    <string name="tile_label">Black Screen</string>

    <string name="start_blackout">Start Screen Off</string>
    <string name="section_content">Content</string>
    <string name="show_clock">Show clock</string>
    <string name="clock_format">Clock format</string>
    <string name="clock_24h">24-hour</string>
    <string name="clock_12h">AM/PM</string>
    <string name="clock_style_label">%1$s (%2$s)</string>
    <string name="sentence">Sentence</string>
    <string name="sentence_hint">Leave empty to show nothing</string>

    <string name="section_appearance">Screen</string>
    <string name="text_level">Brightness</string>
    <string name="brightness_preview_hint">Hold the slider to preview the actual brightness</string>
    <string name="burn_in_shift">Burn-in protection</string>
    <string name="burn_in_shift_desc">Nudges the text position every 60 seconds</string>

    <string name="section_unlock">Unlock</string>

    <string name="gesture_long_press">Press and hold</string>
    <string name="hold_duration_value">Hold duration %1$.1f s</string>
    <string name="gesture_double_tap">Double tap</string>
    <string name="gesture_triple_tap">Triple tap</string>
    <string name="gesture_swipe">Swipe up</string>
    <string name="gesture_slide_to_unlock">Slide to unlock</string>
    <string name="slide_to_unlock_hint">slide to unlock</string>

    <string name="section_mode">Screen Off method</string>
    <string name="mode_blackout">Full black</string>
    <string name="mode_blackout_desc">Hides the status bar too. Needs no permissions. Other apps stop rendering, but background work such as music and downloads continues.</string>
    <string name="mode_overlay">Overlay</string>
    <string name="mode_overlay_desc">Other apps keep rendering, but the status bar and navigation bar cannot be covered and stay visible.</string>
    <string name="overlay_permission_needed">Needs the ‘Display over other apps’ permission</string>
    <string name="grant_permission">Grant permission</string>

    <string name="overlay_channel">Screen Off status</string>
    <string name="overlay_running">Screen Off is on</string>
    <string name="overlay_running_desc">Long-press to unlock, or tap the button below</string>
    <string name="overlay_stop">Unlock</string>

    <string name="section_bubble">Bubble</string>
    <string name="bubble_enabled">Show bubble over other apps</string>
    <string name="bubble_size_value">Bubble size %1$d dp</string>
    <string name="bubble_enabled_desc">A small button that turns Screen Off on while you use other apps. Press and hold, then slide up to open these settings or down to remove the bubble. Drag to move it. It stays after you close the app.</string>
    <string name="bubble_permission_note">The bubble needs the ‘Display over other apps’ permission, separately from the Screen Off method.</string>
    <string name="bubble_running">Bubble is running</string>
    <string name="bubble_running_desc">Tap for Screen Off · hold, then up for app, down to remove</string>
    <string name="bubble_stop">Remove bubble</string>
    <string name="aim_open_app">Open app</string>
    <string name="aim_remove_bubble">Remove bubble</string>

    <string name="accessibility_description">Needed to cover the whole screen. Only an accessibility service can draw a window over the status bar and navigation bar. This app does not read screen content.</string>

    <string name="mode_full">Full screen</string>
    <string name="mode_full_desc">Keeps the app you were using and blacks out the whole screen, including the status bar and navigation bar. Needs the accessibility permission.</string>
    <string name="accessibility_needed">Needs the accessibility permission</string>
    <string name="accessibility_open">Open accessibility settings</string>
</resources>
